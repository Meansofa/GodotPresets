[sub_resource type="GDScript" id="GDScript_wy0jh"]
script/source = "extends RigidBody2D

@export var shaker : ShakerComponent2D
@export var sprite : Sprite2D
@export var face : Sprite2D

var parent_ref: Node = null #the reference to it's parent(for parents to check if this is their child or not)

func _ready() -> void:
	position.x += randi_range(-5, 5)
	position.y += randi_range(-5, 5)

func change_shake(shake_value : float):
	shaker.shake_speed = shake_value

func change_intensity(intensity_value : float):
	shaker.intensity = intensity_value

func change_player(player_index : int):
	_change_color(player_index)
	change_skin_sprite(player_index)

func _change_color(player_index : int):
	sprite.set_material(PlayerData.players[player_index].get_material())

func pop(direction : Vector2):
	set_collision_layer_value(2, true)
	linear_velocity = direction * 500

func change_phase(phase : int):
	if phase > 3:
		return;
	face.frame = phase -1

func change_skin_sprite(player_index : int):
	face.texture = PlayerData.players[player_index].face_texture
"

