; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chain Reaction : Expanded"
config/description="The good old classic Chain Reaction Game with more to offer for players."
config/version="0.0.3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0588235, 0.0156863, 0, 1)
boot_splash/image="uid://bmw15b42dc46g"
config/icon="uid://bmw15b42dc46g"

[autoload]

PlayerData="*res://Scripts/Global Scripts/player_data.gd"
GameState="*res://Scripts/Global Scripts/Game_State.gd"
Shaker="*res://addons/shaker/src/Shaker.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/transparent=true
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor]

movie_writer/movie_file="C:/Users/Admin/Documents/Godot Games/MovieMaker/ChainReaction/ChainReactionFootage.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/shaker/plugin.cfg")

[global_group]

Cell=""
Buttons=""

[input]

Escape={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="Hazards"
2d_physics/layer_4="Environment"
2d_physics/layer_5="Coins"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/transparent_background=true
