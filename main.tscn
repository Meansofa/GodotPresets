[sub_resource type="GDScript" id="GDScript_c516a"]
resource_name = "Inventory"
script/source = "extends VBoxContainer


@onready var skin_options = OptionButton.new()

@export var skin_option : PackedScene

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	#Inventory.connect(\"added_new_skin\", _add_skin)
	PlayerData.connect(\"player_count_changed\", _add_player)
	for i in PlayerData.players.size():
		_add_player()

func _add_skin(new_skin : CompressedTexture2D):
	var hbox = HBoxContainer.new()
	add_child(hbox)
	
	var textureRect = TextureRect.new()
	hbox.add_child(textureRect)
	
	textureRect.texture = new_skin

func _add_player():
	if PlayerData.players.size() < get_children().size():
		while(PlayerData.players.size() < get_children().size()):
			_remove_last_player()
		return
	var hbox = HBoxContainer.new()
	add_child(hbox)
	
	hbox.name = \"Player \" + str(get_children().size())
	
	var player_label = RichTextLabel.new()
	hbox.add_child(player_label)
	
	player_label.text = \"Player \" + str(get_children().size())
	player_label.fit_content = true
	player_label.autowrap_mode = TextServer.AUTOWRAP_OFF
	player_label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	
	var skin_option_copy = skin_option.instantiate()
	hbox.add_child(skin_option_copy)
	
	for skin in Inventory.purchased:
		skin_option_copy.add_icon_item(skin, \"\")
	
	skin_option_copy.connect(\"skin_selected\", select_skin)
	skin_option_copy.player_index = get_children().size() -1

func _remove_last_player():
	get_children()[get_children().size() - 1].queue_free() #remove the memories of the node
	remove_child(get_children()[get_children().size() - 1]) #remove the node as child

func select_skin(skin : CompressedTexture2D, player_index : int): #called from the skin_option
	print(self.name, \">skin selected\")
	PlayerData.players[player_index].face_texture = skin

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

