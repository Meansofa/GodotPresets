[sub_resource type="GDScript" id="GDScript_gh0i5"]
resource_name = "player_display"
script/source = "@tool
extends AspectRatioContainer

@export var player1_scene : PackedScene

@export var row_1 : HBoxContainer
@export var row_2 : HBoxContainer

var player1_instance : TextureRect
static var player_amount : int

func _ready() -> void:
	player1_instance = player1_scene.instantiate()
	GameState.connect(\"restart\", _restart)

func _on_spin_box_value_changed(value: float) -> void:
	player_amount = value
	change_players(player_amount)

func change_players(player_amount : int):
	print(self.name, \"> Players Amount: \", player_amount)
	while  (player_amount > PlayerData.players.size()): #if player_amount value is more than player count, add PlayerData.players to match the player_amount value
		var player = player1_instance.duplicate() #get a copy of player 1
		player.name = \"Player \" + str(PlayerData.players.size() + 1)
		if PlayerData.players.size() < 6: #only 6 PlayerData.players can fit in a column
			row_1.add_child(player)
		else: #once there are more than 6 PlayerData.players, add them to the second row
			row_2.add_child(player)

		PlayerData.add_player(player) #add the duplicated player to the PlayerData.players array

	while  (player_amount < PlayerData.players.size()): #if player_amount value is less than player count, remove PlayerData.players to match the player_amount value
		PlayerData.reduce_player()
	
	change_players_colors()

func change_players_colors():
	for i in PlayerData.players.size(): #change the color depends on how many players
		PlayerData.players[i].set_material(player1_instance.get_material().duplicate(true)) #need to duplicate the material to avoid sharing shaders
		PlayerData.players[i].get_material().set_shader_parameter(\"Shift_Hue\", 1.0 / PlayerData.players.size() * i) #change hue shader

func _restart():
	change_players(player_amount)
"

