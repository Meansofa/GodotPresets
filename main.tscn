[sub_resource type="GDScript" id="GDScript_0obg5"]
resource_name = "TitleScreen"
script/source = "@tool
extends Control

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"Escape\"):
		_toggle_menu()

func _ready() -> void:
	GameState.connect(\"restart\", _restart)

func _restart():
	self.visible = true

func _toggle_menu():
	#%MainMenu.visible = !%MainMenu.visible
	#%UI.visible = !%UI.visible
	%WinnerPanel.visible = false
	GameState.emit_signal(\"restart\")
"

[sub_resource type="GDScript" id="GDScript_qpbas"]
resource_name = "StartButton"
script/source = "extends Button

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"ui_accept\") and %MainMenu.visible:
		emit_signal(\"pressed\")

func _on_pressed() -> void:
	_hide_title_screen()
	_hide_UI()

func _hide_title_screen():
	%MainMenu.visible = false

func _hide_UI():
	%UI.visible = false
"

