[sub_resource type="GDScript" id="GDScript_0obg5"]
resource_name = "TitleScreen"
script/source = "extends Control

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"Escape\") and !%MainMenu.visible:
		_toggle_menu()

func _ready() -> void:
	GameState.connect(\"restart\", _restart)

func _restart():
	self.visible = true

func _toggle_menu():
	GameState.Game_Over = true
	#%MainMenu.visible = !%MainMenu.visible
	#%UI.visible = !%UI.visible
	%In_Game_UI.visible = false
	%WinnerPanel.visible = false
	GameState.emit_signal(\"restart\")
"

