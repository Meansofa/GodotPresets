	pass


func _on_pressed() -> void:
	if mute_icon.frame == 0:
		mute_icon.frame = 1
		AudioServer.set_bus_mute(AudioServer.get_bus_index(\"Master\"), true)
	else:
		mute_icon.frame = 0
		AudioServer.set_bus_mute(AudioServer.get_bus_index(\"Master\"), false)
"

