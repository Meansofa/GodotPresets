	add_child(audioPlayer)
	var buttons: Array = get_tree().get_nodes_in_group(\"Buttons\")
	print(\"buttons: \", buttons)
	for button in buttons:
		print(\"button.name: \", button.name)
		button.connect(\"pressed\", on_button_pressed)

