[sub_resource type="GDScript" id="GDScript_qpbas"]
resource_name = "StartButton"
script/source = "extends Button

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"ui_accept\") and %MainMenu.visible:
		emit_signal(\"pressed\")

func _on_pressed() -> void:
	print(\"START BUTTON\")
	_hide_title_screen()
	_hide_UI()
	_show_in_game_ui()
	GameState.Game_Over = false

func _hide_title_screen():
	%MainMenu.visible = false

func _hide_UI():
	%UI.visible = false

func _show_in_game_ui():
	%In_Game_UI.visible = true
"

